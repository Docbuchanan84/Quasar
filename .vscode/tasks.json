{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Quasar: verify",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/Verify.ps1"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Quasar: server",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/Start-Server.ps1"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Quasar: client",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/Start-Client.ps1"],
      "problemMatcher": []
    }
  ]
}
